# Veritabanı bağlantısı. Geliştirme için SQLite varsayılan.
# Prod için örnek: postgresql+psycopg2://gorkem:sifre@localhost:5432/gorkem
DATABASE_URL=sqlite:///./gorkem.db

# Uygulama
APP_NAME=GÖRKEM
APP_ENV=development
SECRET_KEY=change-this-in-production

# Ekstre eşleştirme eşik değeri (0-100). Bu skorun altındaki satırlar
# "manuel inceleme" kuyruğuna düşer.
STATEMENT_MATCH_THRESHOLD=75
