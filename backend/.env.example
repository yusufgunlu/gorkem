# Veritabanı bağlantısı. BOŞ bırakılırsa (satırı silin/yorumlayın) masaüstü
# uygulaması kullanıcının veri dizinindeki (örn. Windows'ta %APPDATA%\GORKEM)
# bir SQLite dosyasını otomatik kullanır. Sunucu/prod dağıtımı için örnek:
# DATABASE_URL=postgresql+psycopg2://gorkem:sifre@localhost:5432/gorkem

# Uygulama
APP_NAME=GÖRKEM
APP_ENV=development
SECRET_KEY=change-this-in-production

# Ekstre eşleştirme eşik değeri (0-100). Bu skorun altındaki satırlar
# "manuel inceleme" kuyruğuna düşer.
STATEMENT_MATCH_THRESHOLD=75
